// A stand-in for Metal's <metal_stdlib>, so clang (`zig clang`) can check
// myzig's Metal Shading Language as C++14 where no Mac is (check.zig):
// the vector types and the functions the sources use, with Metal's
// overloads (scalars and vectors of float and half; integers where Metal
// has them), declared but not defined. A call Metal has no overload for
// fails here too. What it cannot check: see check.zig.
//
// check.zig rewrites `float2(a, b)` (Metal's vector constructors, which
// C++ has no syntax for) into `__mtl_ctor<float2>(a, b)`, and passes
// `-cl-single-precision-constant`: in Metal a literal like `0.5` is a float.
#pragma once

// Address spaces and entry points: nothing to C++ (see check.zig).
#define device
#define constant
#define thread
#define threadgroup
#define threadgroup_imageblock
#define ray_data
#define object_data
#define vertex
#define fragment
#define kernel
// Metal has no double.
#define double __metal_has_no_double

template <class E, int N> using __mtl_vec = E __attribute__((ext_vector_type(N)));
typedef _Float16 half;
typedef unsigned int uint;
typedef unsigned short ushort;
typedef unsigned char uchar;

#define __MTL_VECS(T, NAME) \
    typedef __mtl_vec<T, 2> NAME##2; \
    typedef __mtl_vec<T, 3> NAME##3; \
    typedef __mtl_vec<T, 4> NAME##4;
__MTL_VECS(float, float)
__MTL_VECS(half, half)
__MTL_VECS(int, int)
__MTL_VECS(uint, uint)
__MTL_VECS(short, short)
__MTL_VECS(ushort, ushort)
__MTL_VECS(char, char)
__MTL_VECS(uchar, uchar)
__MTL_VECS(bool, bool)
// Metal's packed types (no padding): checked as the plain ones.
__MTL_VECS(float, packed_float)
__MTL_VECS(half, packed_half)
__MTL_VECS(int, packed_int)
__MTL_VECS(uint, packed_uint)
#undef __MTL_VECS

// Vector constructors: scalars and vectors whose components add up to
// the vector's, one scalar (spread), or one vector of the same size
// (converted).
template <class T> struct __mtl_info { enum { n = 1, vector = 0, ok = __is_arithmetic(T) }; };
template <class E, int N> struct __mtl_info<__mtl_vec<E, N>> { enum { n = N, vector = 1, ok = 1 }; };

template <class... A> struct __mtl_count;
template <> struct __mtl_count<> { enum { n = 0, ok = 1 }; };
template <class A, class... R> struct __mtl_count<A, R...> {
    enum { n = __mtl_info<A>::n + __mtl_count<R...>::n, ok = __mtl_info<A>::ok && __mtl_count<R...>::ok };
};

template <class V, class... A> inline V __mtl_ctor(A...) {
    static_assert(__mtl_info<V>::vector, "not a vector type");
    static_assert(__mtl_count<A...>::ok, "a vector made from something not a number or vector");
    static_assert(sizeof...(A) == 0 || __mtl_count<A...>::n == __mtl_info<V>::n ||
                      (sizeof...(A) == 1 && __mtl_count<A...>::n == 1),
                  "a vector made from the wrong number of components");
    return V();
}

