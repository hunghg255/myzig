function sidebar(items: DefaultTheme.SidebarItem[]): DefaultTheme.SidebarItem[] {
  return items.map((item) => ({
    ...item,
    text: item.text ? labels[item.text] ?? item.text : undefined,
    link: item.link ? `/vi${item.link}` : undefined,
    items: item.items ? sidebar(item.items) : undefined,
  }))
}

export function vietnamese(sidebars: Record<string, DefaultTheme.SidebarItem[]>): DefaultTheme.Config {
  return {
    nav: [
      { text: 'Hướng dẫn', link: '/vi/getting-started', activeMatch: '^/vi/(?!ui/|plugins|architecture)' },
      { text: 'Giao diện native', link: '/vi/ui/README', activeMatch: '^/vi/ui/' },
      { text: 'Plugin', link: '/vi/plugins', activeMatch: '^/vi/plugins' },
      { text: 'Kiến trúc', link: '/vi/architecture', activeMatch: '^/vi/architecture' },
    ],
    sidebar: Object.fromEntries(Object.entries(sidebars).map(([prefix, items]) => [`/vi${prefix}`, sidebar(items)])),
    outline: { level: [2, 3], label: 'Nội dung trang' },
    docFooter: { prev: 'Trang trước', next: 'Trang tiếp' },
    editLink: { pattern: 'https://github.com/hunghg255/myzig/edit/main/docs/:path', text: 'Chỉnh sửa trang này' },
    footer: { message: 'Phát hành theo giấy phép MIT.', copyright: 'myzig, kế thừa mygo và GPUI' },
    sidebarMenuLabel: 'Mục lục',
    returnToTopLabel: 'Về đầu trang',
    langMenuLabel: 'Đổi ngôn ngữ',
    darkModeSwitchLabel: 'Giao diện',
    lightModeSwitchTitle: 'Chuyển sang giao diện sáng',
    darkModeSwitchTitle: 'Chuyển sang giao diện tối',
    skipToContentLabel: 'Đến nội dung',
  }
}

