// The glow's colors, around a loop from 0 to 1: violet, pink, periwinkle,
// purple, coral and peach, as Apple Intelligence's. The shaders that glow
// with them are compiled after this source (main.zig).
fn palette(x0: f32) vec3 {
    const x = fract(x0) * 6;
    if (x < 1) {
        return mix(vec3(0.74, 0.51, 0.95), vec3(0.96, 0.73, 0.92), x);
    } else if (x < 2) {
        return mix(vec3(0.96, 0.73, 0.92), vec3(0.55, 0.62, 1), x - 1);
    } else if (x < 3) {
        return mix(vec3(0.55, 0.62, 1), vec3(0.67, 0.43, 0.93), x - 2);
    } else if (x < 4) {
        return mix(vec3(0.67, 0.43, 0.93), vec3(1, 0.4, 0.47), x - 3);
    } else if (x < 5) {
        return mix(vec3(1, 0.4, 0.47), vec3(1, 0.73, 0.44), x - 4);
    }
    return mix(vec3(1, 0.73, 0.44), vec3(0.74, 0.51, 0.95), x - 5);
}

// The distance from p, from the rectangle's middle, to a rectangle of half
// size `half` with corners of radius r: below zero inside.
fn round_rect(p: vec2, half: vec2, r: f32) f32 {
    const q = abs(p) - half + r;
    return length(max(q, 0)) + min(max(q.x, q.y), 0) - r;
}

// Where p, from the middle of a box of size `box`, lies around its
// outline, from 0 to 1.
fn around(p: vec2, box: vec2) f32 {
    return atan2(p.y / box.y, p.x / box.x) / 6.2831853 + 0.5;
}

