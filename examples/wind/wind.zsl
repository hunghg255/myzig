// A texture of characters stirred by the wind, after mygo's examples/wind,
// in one pass: the pane is a grid of cells, and every pixel finds the
// wind at its cell's middle (gusts travelling nearly together, eddies
// carried on larger ones, a path that bends) and draws the cell's
// character: a stroke along the way the air blows there, lit by how
// gusty it is. mygo computes the field into a small canvas first and
// draws glyphs from a font's atlas; here the field is found again in
// each pixel of a cell, and the strokes are drawn, not typeset.

// The visit's wind: its seed; its time, in seconds; how far the texture
// has come in, from 0 to 1; the heading it blows toward (a unit vector,
// y down); how far it has carried its gusts by now; the length and width
// of a gust; and how far its path bends, and the size of a bend.
uniform seed: u32;
uniform time: f32;
uniform reveal: f32;
uniform heading: vec2;
uniform carried: f32;
uniform gust_length: f32;
uniform gust_width: f32;
uniform bend: f32;
uniform bend_scale: f32;
// The hand: where the pointer is (it warms the air), and the last click,
// where and when (its blow runs out from there).
uniform pointer: vec2;
uniform tap: vec3;

const cell_w = 9.0;
const cell_h = 18.0;
const detail = 0.6;
const curl = 0.65;
const wisp = 0.5;
const sweep = 0.3;
const morph = 3.0;
const tau = 6.2831853;

fn pcg(v: u32) u32 {
    const s = v * 747796405 + 2891336453;
    const w = ((s >> ((s >> 28) + 4)) ^ s) * 277803737;
    return (w >> 22) ^ w;
}

fn unit(h: u32) f32 {
    return f32(h >> 8) * (1.0 / 16777216.0);
}

fn quintic(f: vec3) vec3 {
    return f * f * f * (f * (f * 6 - 15) + 10);
}

fn corner(h: u32) f32 {
    return unit(pcg(h)) * 2 - 1;
}

// Value noise from -1 to 1 on an integer lattice hashed with the seed.
fn value(p: vec3, salt: u32) f32 {
    const fl = floor(p);
    const w = quintic(p - fl);
    const x0 = u32(i32(fl.x));
    const x1 = u32(i32(fl.x) + 1);
    const y0 = u32(i32(fl.y));
    const y1 = u32(i32(fl.y) + 1);
    const z0 = pcg(u32(i32(fl.z)) ^ seed ^ salt);
    const z1 = pcg(u32(i32(fl.z) + 1) ^ seed ^ salt);
    const a = pcg(y0 ^ z0);
    const b = pcg(y1 ^ z0);
    const c = pcg(y0 ^ z1);
    const d = pcg(y1 ^ z1);
    return mix(
        mix(mix(corner(x0 ^ a), corner(x1 ^ a), w.x), mix(corner(x0 ^ b), corner(x1 ^ b), w.x), w.y),
        mix(mix(corner(x0 ^ c), corner(x1 ^ c), w.x), mix(corner(x0 ^ d), corner(x1 ^ d), w.x), w.y),
        w.z,
    );
}

fn slope(h: u32) vec3 {
    const k = pcg(h);
    return vec3(f32(k & 1023), f32((k >> 10) & 1023), f32((k >> 20) & 1023)) * (2.0 / 1023.0) - 1;
}

// Gradient noise on the same lattice, about -1 to 1.
fn swirl(p: vec3, salt: u32) f32 {
    const fl = floor(p);
    const f = p - fl;
    const w = quintic(f);
    const x0 = u32(i32(fl.x));
    const x1 = u32(i32(fl.x) + 1);
    const y0 = u32(i32(fl.y));
    const y1 = u32(i32(fl.y) + 1);
    const z0 = pcg(u32(i32(fl.z)) ^ seed ^ salt);
    const z1 = pcg(u32(i32(fl.z) + 1) ^ seed ^ salt);
    const a = pcg(y0 ^ z0);
    const b = pcg(y1 ^ z0);
    const c = pcg(y0 ^ z1);
    const d = pcg(y1 ^ z1);
    return 1.5 * mix(
        mix(mix(dot(slope(x0 ^ a), f), dot(slope(x1 ^ a), f - vec3(1, 0, 0)), w.x),
            mix(dot(slope(x0 ^ b), f - vec3(0, 1, 0)), dot(slope(x1 ^ b), f - vec3(1, 1, 0)), w.x), w.y),
        mix(mix(dot(slope(x0 ^ c), f - vec3(0, 0, 1)), dot(slope(x1 ^ c), f - vec3(1, 0, 1)), w.x),
            mix(dot(slope(x0 ^ d), f - vec3(0, 1, 1)), dot(slope(x1 ^ d), f - vec3(1)), w.x), w.y),
        w.z,
    );
}

// How gusty the air is at a point in the wind's own frame: three sizes of
// gust travelling nearly together, thin strands between, and the long
// swells they gather on.
fn gusts(at: vec2, span: f32) f32 {
    const gain = mix(0.38, 0.62, detail);
    var gust = 0.0;
    var weight = 1.0;
    var power = 0.0;
    var box = vec2(0.85 * gust_length, 0.75 * gust_width);
    for (0..3) |i| {
        const k = f32(i);
        gust += weight * swirl(vec3((at.x - carried * (1 + 0.1 * k)) / box.x, at.y / box.y, morph * time * (0.03 + 0.018 * k) + 11 * k), 0x60 + u32(i));
        power += weight * weight;
        weight *= gain;
        box *= vec2(0.5, 0.58);
    }
    const strand = 1 - abs(swirl(vec3((at.x - 1.15 * carried) / (0.7 * gust_length), at.y / (0.95 * gust_width), morph * time * 0.05 + 2), 0x66));
    const swell = cos((at.x - carried + 0.5 * span * value(vec3(time * 0.045, at.y / (2.5 * gust_width), 7), 0x67)) * (tau / span));
    return gust * inversesqrt(power) + wisp * 0.5 * (strand * strand * strand - 0.35) + sweep * swell;
}

// The distance from p to the segment from -h to h.
fn segment(p: vec2, h: vec2) f32 {
    const t = clamp(dot(p, h) / max(dot(h, h), 0.0001), -1, 1);
    return length(p - h * t);
}

pub fn fragment(pos: vec2) vec4 {
    const pane = size();
    const cell = floor(pos / vec2(cell_w, cell_h));
    const p = (cell + 0.5) * vec2(cell_w, cell_h);
    const span = 0.58 * (abs(heading.x) * pane.x + abs(heading.y) * pane.y);

    // The click's blow: a front running out and slowing, pushing the air.
    const age = time - tap.z;
    const away = p - tap.xy;
    const dist = length(away);
    const behind = 620 * (1 - exp(-age / 1.3)) - dist;
    const front = smoothstep(-16, 10, behind) * exp(-behind * behind / ((85 + 60 * age) * (85 + 60 * age)));
    var roused = 0.0;
    if (tap.z > 0 and age > 0) {
        roused = exp(-age / 1.5) * front;
    }
    // The pointer's warmth.
    const near = p - pointer;
    const warm = exp(-dot(near, near) / (2 * 70 * 70));

    // Air that was pushed shows here what was over there, and the wind's
    // path bends, slowly, carrying it along.
    const from = p - away / max(dist, 1) * (44 * roused);
    const turn = vec2(value(vec3(from / bend_scale, time * 0.04), 0x51), value(vec3(from / bend_scale + 17.3, time * 0.04 + 5), 0x52));
    const bent = from + bend * turn;
    const across = vec2(-heading.y, heading.x);
    const q = vec2(dot(bent, heading), dot(bent, across));

    // The air curls: small eddies carried on large ones.
    const riding = vec2(q.x - 0.85 * carried, q.y);
    const eddy_size = 1.15 * gust_width;
    const eddy = vec2(swirl(vec3(riding / eddy_size, morph * time * 0.04), 0x59), swirl(vec3(riding / eddy_size + 31.7, morph * time * 0.04 + 3), 0x5a));
    const folded = riding + curl * 0.9 * gust_width * eddy;
    const fine_size = 0.38 * gust_width;
    const fine = vec2(swirl(vec3(folded / fine_size, morph * time * 0.06), 0x5b), swirl(vec3(folded / fine_size + 13.1, morph * time * 0.06 + 7), 0x5c));
    const curled = q + curl * (1 + 0.9 * min(roused, 1.5)) * gust_width * (0.9 * eddy + 0.3 * fine);
    const blows = normalize(heading + 0.6 * turn + away / max(dist, 1) * roused * 3 + curl * ((0.45 * eddy.x + 0.25 * fine.x) * heading + (0.45 * eddy.y + 0.25 * fine.y) * across));

    // Light where it is gusty, thinner behind the middle of the pane.
    const field = gusts(curled, span) + 1.9 * roused;
    var strength = smoothstep(0.1, 0.9, field) * (0.82 + 0.18 * fine.y);
    strength = 1 - (1 - strength) * (1 - 0.7 * warm);
    const e = (p - vec2(0.5 * pane.x, 0.45 * pane.y)) / vec2(250, 80);
    const calm = 1 - 0.7 * exp(-0.9 * dot(e, e));
    const lit = clamp(strength * calm * max(reveal, min(1, 2 * roused + warm)), 0, 1);

    // The cell's character: a stroke along the wind, longer where it is
    // lit; a dot where the air is still.
    const local = pos - p;
    const reach = mix(0.6, 4.2, lit);
    const d = segment(local, blows * vec2(reach, reach * 1.6));
    const ink = clamp(1.1 - d * pixel_scale(), 0, 1) * smoothstep(0.04, 0.2, lit) * (0.35 + 0.65 * lit);
    const b = backdrop(pos).rgb;
    const dark = dot(b, vec3(0.3, 0.59, 0.11)) < 0.5;
    var color = vec3(0.16, 0.24, 0.42);
    if (dark) {
        color = vec3(0.72, 0.82, 1);
    }
    // Warmer where the pointer stirred it or a blow went by.
    color = mix(color, vec3(0.95, 0.45, 0.25), clamp(0.8 * roused + 0.5 * warm, 0, 0.8));
    return vec4(color * ink, ink);
}
