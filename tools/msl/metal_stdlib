// Samplers: made from Metal's enums, constexpr.
enum class coord { normalized, pixel };
enum class filter { nearest, linear };
enum class min_filter { nearest, linear };
enum class mag_filter { nearest, linear };
enum class mip_filter { none, nearest, linear };
enum class address { repeat, mirrored_repeat, clamp_to_edge, clamp_to_zero, clamp_to_border };
enum class s_address { repeat, mirrored_repeat, clamp_to_edge, clamp_to_zero, clamp_to_border };
enum class t_address { repeat, mirrored_repeat, clamp_to_edge, clamp_to_zero, clamp_to_border };
enum class border_color { transparent_black, opaque_black, opaque_white };
enum class compare_func { none, less, less_equal, greater, greater_equal, equal, not_equal, always, never };

template <class T> struct __mtl_sampler_arg { enum { ok = 0 }; };
#define __MTL_SAMPLER_ARG(E) template <> struct __mtl_sampler_arg<E> { enum { ok = 1 }; };
__MTL_SAMPLER_ARG(coord) __MTL_SAMPLER_ARG(filter) __MTL_SAMPLER_ARG(min_filter)
__MTL_SAMPLER_ARG(mag_filter) __MTL_SAMPLER_ARG(mip_filter) __MTL_SAMPLER_ARG(address)
__MTL_SAMPLER_ARG(s_address) __MTL_SAMPLER_ARG(t_address) __MTL_SAMPLER_ARG(border_color)
__MTL_SAMPLER_ARG(compare_func)
template <class... A> struct __mtl_sampler_args;
template <> struct __mtl_sampler_args<> { enum { ok = 1 }; };
template <class A, class... R> struct __mtl_sampler_args<A, R...> {
    enum { ok = __mtl_sampler_arg<A>::ok && __mtl_sampler_args<R...>::ok };
};

struct sampler {
    constexpr sampler() {}
    template <class... A> constexpr sampler(A...) {
        static_assert(__mtl_sampler_args<A...>::ok, "a sampler is made from Metal's sampler enums");
    }
};

// Textures: 2D, as the sources use them.
enum class access { sample, read, write, read_write };

template <class T, access A = access::sample> struct texture2d {
    static_assert(__is_same(T, float) || __is_same(T, half) || __is_same(T, int) ||
                      __is_same(T, uint) || __is_same(T, short) || __is_same(T, ushort),
                  "texture2d of float, half, int, uint, short or ushort");
    typedef __mtl_vec<T, 4> texel;
    texel sample(sampler, float2) const;
    texel sample(sampler, float2, int2) const;
    texel read(uint2, uint = 0) const;
    texel read(ushort2, ushort = 0) const;
    void write(texel, uint2, uint = 0) const;
    void write(texel, ushort2, ushort = 0) const;
    uint get_width(uint = 0) const;
    uint get_height(uint = 0) const;
    uint get_num_mip_levels() const;
};

