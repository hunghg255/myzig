// A black hole, its accretion disk and the sky behind, as light from them
// reaches the camera: each pixel's ray is traced backward, bent by the
// hole's gravity (Schwarzschild's, in units of its radius), through the
// disk, which it may cross several times, above and below, to the stars
// or into the hole. After mygo's examples/blackhole.

// The disk's time, in seconds.
uniform time: f32;
// The camera: where it is, its axes (unit vectors, y up; up is
// cross(right, forward)) and its focal length, in heights of the view.
uniform eye: vec3;
uniform right: vec3;
uniform forward: vec3;
uniform focal: f32;
// How many steps a ray takes at most (fewer draw faster, the disk rougher).
uniform steps: i32;

const disk_in = 2.6;
const disk_out = 13.0;
const escape = 42.0;

fn pcg(v: u32) u32 {
    const s = v * 747796405 + 2891336453;
    const w = ((s >> ((s >> 28) + 4)) ^ s) * 277803737;
    return (w >> 22) ^ w;
}

// A number from 0 to 1 for a point of the integer lattice.
fn hash13(p: vec3) f32 {
    const h = pcg(u32(i32(p.x)) ^ pcg(u32(i32(p.y)) ^ pcg(u32(i32(p.z)))));
    return f32(h >> 8) * (1.0 / 16777216.0);
}

// Value noise from 0 to 1.
fn noise(p: vec3) f32 {
    const i = floor(p);
    var f = p - i;
    f = f * f * (3 - 2 * f);
    return mix(
        mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x), mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y),
        mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x), mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y),
        f.z,
    );
}

fn fbm(p0: vec3) f32 {
    var p = p0;
    var s = 0.0;
    var a = 0.5;
    for (0..5) |i| {
        s += a * noise(p);
        p = p * 2.03 + 17.1;
        a *= 0.5;
    }
    return s;
}

// The color of gas at a temperature from 0 (cool, deep red) to 1 (hot,
// blue white).
fn blackbody(t: f32) vec3 {
    var c = mix(vec3(1, 0.16, 0.02), vec3(1, 0.5, 0.15), smoothstep(0, 0.3, t));
    c = mix(c, vec3(1, 0.84, 0.62), smoothstep(0.25, 0.65, t));
    return mix(c, vec3(0.78, 0.86, 1), smoothstep(0.7, 1, t));
}

// The light of the disk where a ray along d crosses it at p, and how
// dense the gas is there.
fn disk(p: vec3, d: vec3) vec4 {
    const r = length(p.xz);
    if (r < disk_in or r > disk_out) {
        return vec4(0);
    }
    // The gas orbits, faster inside, and its streaks shear along.
    const a = -time * 1.6 * pow(r, -1.5);
    const c = cos(a);
    const s = sin(a);
    const q = vec2(c * p.x - s * p.z, s * p.x + c * p.z);
    const ang = atan2(q.y, q.x);
    const streaks = fbm(vec3(1.3 * cos(ang), 1.3 * sin(ang), r * 3.2));
    const clumps = fbm(vec3(q * 0.8, r * 0.5 + 3));
    var dens = smoothstep(disk_in, disk_in + 0.4, r) * pow(smoothstep(disk_out, disk_in, r), 1.6);
    dens *= clamp(0.15 + 1.6 * streaks * streaks * (0.4 + clumps), 0, 1.4);

    const t = clamp(pow(disk_in / r, 1.05), 0, 1);
    var col = blackbody(t) * (0.12 + 4.5 * t * t * t);
    // Doppler beaming: the side coming toward the camera is brighter and
    // bluer, the side going away dimmer and redder; light climbing out of
    // the well loses some too.
    const v = min(sqrt(0.5 / (r - 1)), 0.62);
    const toward = dot(normalize(vec3(-p.z, 0, p.x)), -d);
    const doppler = sqrt(1 - v * v) / (1 - v * toward);
    const shift = doppler * sqrt(1 - 1 / r);
    col *= pow(shift, 2.4);
    col = mix(col * vec3(1.15, 0.75, 0.55), col * vec3(0.8, 0.92, 1.25), smoothstep(0.7, 1.3, shift));
    return vec4(col, dens);
}

// The light coming from far away along d: a galaxy's band of dust and
// glow, and stars.
fn sky(d: vec3) vec3 {
    var col = vec3(0.002, 0.0025, 0.005);
    const b = dot(d, normalize(vec3(0.25, 1, 0.35)));
    const neb = fbm(d * 3.2 + 10);
    const dust = fbm(d * 8 - 3);
    const band = exp(-b * b * 10) * (0.3 + neb);
    col += band * mix(vec3(0.07, 0.05, 0.12), vec3(0.2, 0.13, 0.08), dust) * 0.55;
    col *= 1 - 0.75 * exp(-b * b * 60) * smoothstep(0.42, 0.65, dust);
    for (0..2) |layer| {
        const g = d * (110.0 + 160 * f32(layer));
        const cell = floor(g);
        const h = hash13(cell + vec3(f32(layer) * 1000));
        const th = 0.94 - 0.03 * band;
        if (h > th) {
            const off = 0.25 + 0.5 * vec3(hash13(cell + vec3(7, 0, 0)), hash13(cell + vec3(0, 3, 0)), hash13(cell + vec3(0, 0, 11)));
            const e = g - cell - off;
            const k = (h - th) / (1 - th);
            const tint = mix(vec3(1, 0.75, 0.55), vec3(0.7, 0.82, 1), hash13(cell + vec3(5, 5, 0)));
            col += tint * k * k * k * 7 * exp(-dot(e, e) * 260);
        }
    }
    return col;
}

// The direction of the camera's ray through pos.
fn ray(pos: vec2) vec3 {
    const box = size();
    const uv = (pos - 0.5 * box) / box.y;
    const up = cross(right, forward);
    return normalize(forward * focal + right * uv.x - up * uv.y);
}

fn hash12(p: vec2) f32 {
    var p3 = fract(p.xyx * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

fn aces(x: vec3) vec3 {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0, 1);
}

pub fn fragment(pos: vec2) vec4 {
    var p = eye;
    var v = ray(pos);
    const l = cross(p, v);
    const h2 = dot(l, l);
    var col = vec3(0);
    var alpha = 0.0;
    var glow = 0.0;
    var escaped = false;
    for (0..steps) |i| {
        const r2 = dot(p, p);
        const r = sqrt(r2);
        if (r < 1) {
            break;
        }
        var dt = clamp(0.06 * r, 0.015, 1.5);
        // Near the disk's plane, smaller steps find its edge sharp.
        if (abs(p.y) < 0.6 and r < disk_out + 1) {
            dt = min(dt, max(0.05, abs(p.y)));
        }
        v += -1.5 * h2 * p / (r2 * r2 * r) * dt;
        const np = p + v * dt;
        if (p.y * np.y <= 0 and p.y != np.y) {
            const hit = mix(p, np, p.y / (p.y - np.y));
            const e = disk(hit, normalize(v));
            const a = clamp(e.a, 0, 1);
            col += (1 - alpha) * e.rgb * a;
            alpha += (1 - alpha) * a * 0.92;
        }
        // Light circling near the photon sphere, a faint halo.
        const x = r - 1.5;
        glow += exp(-x * x * 6) * dt;
        p = np;
        if (r > escape and dot(p, v) > 0) {
            escaped = true;
            break;
        }
        if (alpha > 0.995) {
            break;
        }
    }
    // A ray still circling when its steps run out is as good as caught.
    if (escaped) {
        col += (1 - alpha) * sky(normalize(v));
        col += vec3(1, 0.62, 0.32) * glow * 0.03 * (1 - alpha);
    }
    col = pow(aces(col * 1.1), vec3(1 / 2.2));
    // The finish (mygo's post pass): darker corners and a film's grain.
    const uv = pos / size();
    col *= 0.25 + 0.75 * pow(16 * uv.x * uv.y * (1 - uv.x) * (1 - uv.y), 0.22);
    col += (hash12(pixel() + fract(time) * 131) - 0.5) / 96;
    return vec4(clamp(col, 0, 1), 1);
}
