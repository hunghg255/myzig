// What the effort slider's shaders share: the demo's hash of three
// integers, from 0 to 1, a twinkle that blinks on and off, and `over`.

fn hash(a: i32, b: i32, c: i32) f32 {
    var h = u32(a) * 0x9e3779b1 ^ u32(b) * 0x85ebca77 ^ u32(c) * 0xc2b2ae3d;
    h ^= h >> 15;
    h *= 0x2c1b3c6d;
    h ^= h >> 12;
    h *= 0x297a2d39;
    h ^= h >> 15;
    return f32(h & 0xffffff) / 16777215.0;
}

// How lit a pixel seeded by a and b is at t seconds: it blinks on, at a
// pace and a phase of its own, and stays dark a while.
fn twinkle(a: i32, b: i32, t: f32) f32 {
    const period = 0.7 + 1.1 * hash(a, b, 1);
    const k = fract(t / period + hash(a, b, 2));
    const on = 0.35 + 0.4 * hash(a, b, 3);
    if (k > on) {
        return 0;
    }
    return sin(k / on * 3.14159265);
}

// `top` (premultiplied) over `under`.
fn over(top: vec4, under: vec4) vec4 {
    return top + under * (1 - top.a);
}

