// The slider's thumb, a brain, and in Galaxy what comes out of it: a
// glow behind, sparkles over it, dotted rays streaming out, twinkling,
// and a burst of pixels as it goes Galaxy. The box is centered on the
// brain.

uniform time: f32;
uniform galaxy: f32;
// How far the burst has gone, from 0 to 1 (outside: none).
uniform burst: f32;
// The brain's size, in points.
uniform brain: f32;

const tau = 6.2831853;

fn ray_color(i: i32) vec3 {
    if (i == 0) {
        return vec3(0.373, 0.706, 0.741);
    } else if (i == 1) {
        return vec3(0.604, 0.604, 0.675);
    }
    return vec3(0.702, 0.659, 0.941);
}

fn burst_color(i: i32) vec3 {
    const k = i % 5;
    if (k == 0) {
        return vec3(0.357, 0.235, 0.941);
    } else if (k == 1) {
        return vec3(0.404, 0.91, 0.976);
    } else if (k == 2) {
        return vec3(1);
    } else if (k == 3) {
        return vec3(0.957, 0.447, 0.714);
    }
    return vec3(0.655, 0.545, 0.98);
}

// How much the square of side s at p covers the pixel at v.
fn square(v: vec2, p: vec2, s: f32) f32 {
    const d = abs(v - p) - 0.5 * s;
    const k = pixel_scale();
    return clamp(0.5 - d.x * k, 0, 1) * clamp(0.5 - d.y * k, 0, 1);
}

// The brain: two lobes, folds inside, filled pink (violet in Galaxy) and
// outlined.
fn brain_at(v: vec2) vec4 {
    const s = brain / 24;
    const p = v / s;
    const left = length((p - vec2(-3.2, 0)) / vec2(7.6, 9.2)) - 1;
    const right = length((p - vec2(3.2, 0)) / vec2(7.6, 9.2)) - 1;
    const d = min(left, right) * 8.4 * s;
    const k = pixel_scale();
    const fill_a = clamp(0.5 - d * k, 0, 1);
    const violet = mix(vec3(0.545, 0.569, 0.992), vec3(0.718, 0.506, 0.953), clamp((p.x + p.y) / 18 + 0.5, 0, 1));
    const fill = mix(vec3(0.992, 0.573, 0.729), violet, galaxy);
    const stroke = mix(vec3(0.38, 0.094, 0.212), vec3(0.133, 0.075, 0.486), galaxy);
    var line = clamp(1.4 * s - abs(d) * k, 0, 1);
    if (d < 0) {
        const folds = min(abs(p.x - 0.6 * sin(p.y * 0.7)), min(abs(p.y - 2.5 - 1.2 * sin(p.x * 0.9)), abs(p.y + 3 + 1.2 * cos(p.x * 0.8))));
        line = max(line, clamp(1.2 - folds * s * k, 0, 1) * 0.85);
    }
    const a = max(fill_a, line);
    return vec4(mix(fill, stroke, line) * a, a);
}

pub fn fragment(pos: vec2) vec4 {
    const v = pos - 0.5 * size();
    var c = vec4(0);
    if (galaxy > 0) {
        // The glow behind.
        const g2 = dot(v, v) / (34.0 * 34.0);
        const glow = 0.55 * galaxy * exp(-g2 * 4.5) * max(0, 1 - g2);
        c = vec4(vec3(0.545, 0.569, 0.992) * glow, glow);
        // The rays: dots every two points, from 19 out.
        for (0..16) |i| {
            const angle = (f32(i) + 0.4 * hash(i, 0, 5)) * tau / 16;
            const dir = vec2(cos(angle), sin(angle));
            const along = dot(v, dir);
            const len = 10 + 26 * hash(i, 0, 6) * hash(i, 0, 12);
            if (along >= 18 and along < 20 + len) {
                const at = 19 + 2 * floor((along - 18) / 2);
                if (at < 19 + len) {
                    const k = (at - 19) / len;
                    const lit = 0.4 + 0.6 * twinkle(i, i32(at), time * 1.6);
                    const a = (1 - k) * 0.65 * lit * galaxy * square(v, dir * at, 1);
                    c = over(vec4(ray_color(i32(hash(i, i32(at), 7) * 3)) * a, a), c);
                }
            }
        }
    }
    c = over(brain_at(v), c);
    if (galaxy > 0) {
        // Sparkles over the brain.
        for (0..10) |i| {
            const p = vec2(-10 + 20 * hash(i, 2, 10), -9 + 18 * hash(i, 2, 11));
            const a = twinkle(i, 99, time * 1.3) * galaxy * square(v, p, 1.5);
            var color = vec3(1);
            if (i % 3 == 0) {
                color = vec3(0.49, 0.827, 0.988);
            }
            c = over(vec4(color * a, a), c);
        }
    }
    // The burst of pixels, flying out as Galaxy starts.
    if (burst > 0 and burst < 1) {
        const e = 1 - pow(1 - burst, 3);
        for (0..28) |i| {
            const angle = (f32(i) + 0.3 * hash(i, 1, 8)) * tau / 28;
            const r = 11 + (6 + 12 * hash(i, 1, 9)) * e;
            const p = vec2(r * cos(angle) * 1.05, r * sin(angle) * 0.95);
            const a = (1 - burst * burst) * square(v, p, 2);
            c = over(vec4(burst_color(i) * a, a), c);
        }
    }
    return c;
}
